      "id": 1,
      "title": "Greetings and simple replies",
      "level": "beginner",
      "lines": [
        {
          "speaker": "Male 1",
          "ar": "السلام عليكم",
          "trans": "Peace be upon you.",
          "audio": "audio/lesson-01/line-01.mp3"
        },
        {
          "speaker": "Male 2",
          "ar": "وعليكم السلام، شحالك؟",
          "trans": "And peace be upon you. How are you?",
          "audio": "audio/lesson-01/line-02.mp3"
        },
        {
          "speaker": "Male 1",
          "ar": "زين، الحمد لله. وإنت؟",
          "trans": "Good, thank God. And you?",
          "audio": "audio/lesson-01/line-03.mp3"
        }
      ]
    },
    {
      "id": 2,
      "title": "What, where, and who",
      "level": "beginner",
      "lines": [
        {
          "speaker": "Male 1",
          "ar": "وين رايح؟",
          "trans": "Where are you going?",
          "audio": "audio/lesson-02/line-01.mp3"
        },
        {
          "speaker": "Male 2",
          "ar": "رايح الدوام.",
          "trans": "I'm going to work.",
          "audio": "audio/lesson-02/line-02.mp3"
        }
      ]
    }
  ]
